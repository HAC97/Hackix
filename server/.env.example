# Google Cloud OAuth 2.0 credentials
# Obtenlas en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu-client-id-aqui
GOOGLE_CLIENT_SECRET=tu-client-secret-aqui
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Session secret (cambia esto por algo aleatorio)
SESSION_SECRET=cambia-esto-por-un-valor-secreto-aleatorio

# Server port
PORT=4000

# Frontend URL (para redireccion post-login)
FRONTEND_URL=http://localhost:3000

# Entorno: development o production
NODE_ENV=development
